# docker-compose.yml 用。cp .env.example .env して自分の環境に合わせる。

# mirakc のエンドポイント（必須）。
# EPGStation と同じ mirakc を指してよい（チューナーは mirakc が調停する。
# 注意点は docs/runbook/shadow.md「EPGStation との並走」を参照）。
MIRAKC_URL=http://192.168.1.10:40772

# PostgreSQL（必須）
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=rokuban
# POSTGRES_DB=rokuban

# Host ヘッダー allowlist。空なら検証しない（LAN 内で IP 直叩きする場合）。
# リバースプロキシ越しに公開するなら必ず設定する。
# ROKUBAN_ALLOWED_HOSTS=rokuban.local

# ポート（ホスト側）
# ROKUBAN_PORT=40773
# POSTGRES_PORT=5432

# イメージ。ローカルビルドを使うなら docker build -t rokuban:dev . して rokuban:dev を指定。
# ROKUBAN_IMAGE=ghcr.io/fetburner/rokuban:latest

# 動作調整
# ROKUBAN_INGEST_CONCURRENCY=2
# ROKUBAN_EPG_SYNC_INTERVAL=10m
# ROKUBAN_EPG_RETENTION_GRACE=24h
# ROKUBAN_LOG_LEVEL=info
# ROKUBAN_LOG_FORMAT=json
