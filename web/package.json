{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --max-warnings=2 --report-unused-disable-directives-severity=error && node scripts/check-lint-suppressions.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "check:colors": "node scripts/check-colors.mjs",
    "check:lint-suppressions": "node scripts/check-lint-suppressions.mjs",
    "e2e": "node e2e/run.mjs",
    "e2e:fixtures": "node e2e/validate-fixtures.mjs",
    "screenshots:readme": "node e2e/readme-screenshots.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.6"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": ">=4.3.0 <5",
      "@hono/node-server": ">=2.0.5 <3",
      "brace-expansion": ">=5.0.8 <6"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.1.1",
    "orval": "^8.38.0",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
}
