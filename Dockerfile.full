# ffmpeg 入りイメージのビルド例。
# 公式イメージは ffmpeg を含まない（ライセンス・特許上の理由）。
# worker / streamer ロールや --all で使う場合はこの Dockerfile でセルフビルドする。
#
#   docker build -f Dockerfile.full --build-arg BASE=ghcr.io/fetburner/rokuban:latest -t rokuban-full .
#
# HW エンコード（VAAPI / QSV / NVENC）が必要なら、ベースイメージや
# ffmpeg パッケージを環境に合わせて差し替えること。
# **ARIB 字幕（live.captions / encode profile の subtitles）を使うならこの
# Dockerfile では足りない。** apt の ffmpeg に libaribcaption は入っていない
# ---- bookworm の 5.1 だけでなく trixie の 7.1.5 でも入っていない（実測:
# `ffmpeg -decoders | grep aribcaption` が 0 件）。Debian に他の ARIB
# デコーダ入りパッケージがあるわけでもない。
# 字幕を使うなら `--enable-libaribcaption` 付きの ffmpeg を自分で用意して
# この Dockerfile の apt 版と差し替えること（ffmpeg 入りイメージはユーザーが
# 自分用にビルドする —— docs/overview.md §イメージ戦略と配布物）。
# **その ffmpeg を apt 版で置き換えると、apt 版が持っているエンコーダを
# 失う点に注意。** apt 版は libx264 / libx265 / libvpx-vp9 / libaom-av1 /
# libsvtav1 / h264_vaapi / hevc_vaapi を持つ（実測）ので、HW エンコード
# （config.example.yml の h264_vaapi 例）を併用するなら configure に
# `--enable-vaapi` 等も足す必要がある。
# Rokuban は captions / subtitles 有効時に起動時の `ffmpeg -decoders` 検査で
# 不足を明示するので、字幕が黙って消えることはない。

ARG BASE=ghcr.io/fetburner/rokuban:latest
FROM ${BASE}
USER root
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends ffmpeg
USER nobody
ENTRYPOINT ["rokuban"]
