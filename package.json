{
  "name": "rokuban-docs",
  "private": true,
  "scripts": {
    "docs:lint": "textlint --rulesdir scripts/textlint-rules 'README.md' 'CLAUDE.md' 'deploy/**/*.md' 'docs/**/*.md' 'web/e2e/**/*.md'",
    "third-party-notices": "node scripts/third-party-notices.mjs",
    "docs:allow-total": "node scripts/check-allow-total.mjs",
    "docs:reading": "node scripts/docs-reading/run.mjs"
  },
  "devDependencies": {
    "textlint": "15.8.0",
    "textlint-rule-preset-ja-technical-writing": "12.0.2"
  }
}
