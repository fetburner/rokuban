# ARIB 字幕（live.captions / encode profile の subtitles）を使う場合の
# ffmpeg 入りイメージのビルド例。Dockerfile.full の apt 版では字幕が使えない
# ---- Debian の apt ffmpeg に libaribcaption は入っていない（bookworm の 5.1、
# trixie の 7.1.5 いずれも `ffmpeg -decoders | grep aribcaption` が 0 件）。
#
#   docker build -f Dockerfile.captions --build-arg BASE=ghcr.io/fetburner/rokuban:latest -t rokuban-captions .
#
# **第三者のビルド済み ffmpeg バイナリは持ち込まない。** 信頼の起点を
# 公式 debian イメージと上流の git タグだけに保つため、libaribcaption と
# ffmpeg はソースからビルドする。ARIBCAPTION_REF / FFMPEG_REF は明示的な
# タグで固定してある（更新するときは両方を同じ PR で上げる）。
#
# HW エンコード（VAAPI / QSV / NVENC）が必要なら configure に
# --enable-vaapi 等を足し、ランタイム側のドライバも入れること。

ARG BASE=ghcr.io/fetburner/rokuban:latest

FROM debian:bookworm-slim AS ffmpeg-build

# libfreetype-dev / libfontconfig-dev は libaribcaption のレンダラが要求する
# （字幕をテキストとして出す用途でも CMake の依存検査を通すために必要）。
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git pkg-config nasm yasm ca-certificates \
      libx264-dev libfreetype-dev libfontconfig-dev \
    && rm -rf /var/lib/apt/lists/*

ARG ARIBCAPTION_REF=v1.1.1
RUN git clone --depth 1 --branch "${ARIBCAPTION_REF}" \
      https://github.com/xqq/libaribcaption.git /src/libaribcaption \
    && cmake -S /src/libaribcaption -B /src/libaribcaption/build \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DARIBCC_SHARED_LIBRARY=ON \
    && cmake --build /src/libaribcaption/build -j"$(nproc)" \
    && cmake --install /src/libaribcaption/build \
    && ldconfig

# 音声は encode / live のプロファイルが使うネイティブ aac エンコーダで足りるので
# libfdk-aac は入れない（--enable-nonfree を避ける）。
ARG FFMPEG_REF=n7.1.1
RUN git clone --depth 1 --branch "${FFMPEG_REF}" \
      https://github.com/FFmpeg/FFmpeg.git /src/ffmpeg
WORKDIR /src/ffmpeg
RUN PKG_CONFIG_PATH=/usr/local/lib/pkgconfig ./configure \
      --prefix=/usr/local \
      --enable-gpl --enable-libx264 --enable-libaribcaption \
      --disable-doc --disable-debug \
    && make -j"$(nproc)" && make install

FROM ${BASE}
USER root
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      libx264-164 libfreetype6 libfontconfig1
COPY --from=ffmpeg-build /usr/local/bin/ffmpeg /usr/local/bin/ffprobe /usr/local/bin/
COPY --from=ffmpeg-build /usr/local/lib/ /usr/local/lib/
RUN ldconfig && ffmpeg -hide_banner -decoders | grep -q libaribcaption
USER nobody
ENTRYPOINT ["rokuban"]
