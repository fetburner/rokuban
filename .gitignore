# 実機（mirakc）や実録画データに依存するテストの置き場。
# 環境依存性が大きく CI では走らせられないため追跡しない（各自のローカルにだけ置く）。
# 詳細は test/integration/integration.go の doc コメント。
/test/integration/

# docker-compose の実値（機微情報を含む）。.env.example を雛形に各自で作る。
/.env

# ローカル検証用の設定（環境固有の値を含む）
/dev.local.yml

# `go build -o rokuban` で作られるローカルバイナリ（30MB 超。追跡しない）。
/rokuban

# エディタのスワップ・一時ファイル。
*.swp

# ルートの docs-lint 用ツール（package.json / package-lock.json は追跡する）。
/node_modules/

# Claude Code のローカル状態。settings.local.json は各自の許可設定、
# worktrees はエージェント実行用の一時ワークツリー（残ると数百 MB になり、
# grep や `git add -A` を汚す）。
# 共有したい設定（.claude/settings.json / agents / commands）は追跡できるよう、
# ディレクトリ全体は無視しない。
/.claude/settings.local.json
/.claude/worktrees/
